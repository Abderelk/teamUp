# Configuration MapBox pour la géolocalisation
EXPO_PUBLIC_MAPBOX_TOKEN=your_mapbox_access_token_here

# Pour obtenir votre token MapBox:
# 1. Créez un compte sur https://www.mapbox.com/
# 2. Allez dans votre dashboard > Access tokens
# 3. Créez un nouveau token ou utilisez le token par défaut
# 4. Copiez le token et remplacez "your_mapbox_access_token_here"
# 5. Renommez ce fichier en .env