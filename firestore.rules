rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Règles pour les profils utilisateur
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && validateUserData(request.resource.data);
      allow delete: if false; // Pas de suppression de profil
    }
    
    // Règles pour les événements
    match /events/{eventId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null 
        && request.auth.uid == request.resource.data.organizerId
        && validateEventData(request.resource.data);
      allow update: if request.auth != null 
        && request.auth.uid == resource.data.organizerId
        && validateEventData(request.resource.data);
      allow delete: if request.auth != null 
        && request.auth.uid == resource.data.organizerId;
    }
    
    // Règles pour les chats d'événements
    match /chats/{chatId} {
      allow read: if request.auth != null 
        && (request.auth.uid in resource.data.participantIds);
      allow create: if request.auth != null 
        && request.auth.uid in request.resource.data.participantIds
        && validateChatData(request.resource.data);
      allow update: if request.auth != null 
        && (request.auth.uid in resource.data.participantIds || request.auth.uid in request.resource.data.participantIds)
        && validateChatData(request.resource.data);
      allow delete: if false; // Les chats ne sont pas supprimés
      
      // Règles pour les messages du chat
      match /messages/{messageId} {
        allow read: if request.auth != null 
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
        allow create: if request.auth != null 
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds
          && request.auth.uid == request.resource.data.authorId
          && validateMessageData(request.resource.data);
        allow update: if request.auth != null 
          && request.auth.uid == resource.data.authorId
          && validateMessageData(request.resource.data);
        allow delete: if request.auth != null 
          && request.auth.uid == resource.data.authorId;
      }
    }
    
    // Règles pour les notifications
    match /notifications/{notificationId} {
      allow read, update: if request.auth != null 
        && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null 
        && request.auth.uid == request.resource.data.userId
        && validateNotificationData(request.resource.data);
      allow delete: if request.auth != null 
        && request.auth.uid == resource.data.userId;
    }
    
    // Règles pour les profils sportifs
    match /sportProfiles/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null 
        && request.auth.uid == userId
        && validateSportProfileData(request.resource.data);
      allow delete: if request.auth != null 
        && request.auth.uid == userId;
    }

    // Règles pour les équipes
    match /teams/{teamId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null 
        && request.auth.uid == request.resource.data.createdBy
        && validateTeamData(request.resource.data);
      allow update: if request.auth != null 
        && validateTeamData(request.resource.data);
      allow delete: if request.auth != null 
        && request.auth.uid == resource.data.createdBy;
    }

    // Règles pour les codes d'invitation d'équipe
    match /teamInviteCodes/{codeId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null 
        && validateTeamInviteCodeData(request.resource.data);
      allow update: if request.auth != null 
        && validateTeamInviteCodeData(request.resource.data);
      allow delete: if request.auth != null;
    }
    
    // Fonctions de validation
    function validateUserData(data) {
      return data.keys().hasAll(['firstName', 'lastName', 'email', 'uid'])
        && data.firstName is string && data.firstName.size() > 0 && data.firstName.size() <= 50
        && data.lastName is string && data.lastName.size() > 0 && data.lastName.size() <= 50
        && data.email is string && data.email.matches('.*@.*\\..*')
        && data.uid is string;
    }
    
    function validateEventData(data) {
      return data.keys().hasAll(['title', 'sport', 'dateTime', 'duration', 'maxParticipants', 'requiredLevel', 'status', 'organizerId', 'location'])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 100
        && data.description is string && data.description.size() <= 500
        && data.sport is string && data.sport in ['football', 'basketball', 'tennis', 'volleyball', 'badminton', 'handball', 'ping-pong', 'running', 'cycling', 'swimming', 'other']
        && data.dateTime is timestamp
        && data.duration is number && data.duration >= 30 && data.duration <= 300
        && data.maxParticipants is number && data.maxParticipants >= 2 && data.maxParticipants <= 30
        && data.requiredLevel is string && data.requiredLevel in ['beginner', 'intermediate', 'advanced']
        && data.status is string && data.status in ['draft', 'published', 'cancelled', 'completed']
        && data.organizerId is string
        && validateLocationData(data.location);
    }
    
    function validateLocationData(location) {
      return location.keys().hasAll(['city'])
        && location.city is string && location.city.size() > 0 && location.city.size() <= 100
        && (!('name' in location) || (location.name is string && location.name.size() <= 100))
        && (!('address' in location) || (location.address is string && location.address.size() <= 200));
    }
    
    // Fonctions de validation pour les chats
    function validateChatData(data) {
      return data.keys().hasAll(['type', 'name', 'participantIds', 'isActive'])
        && data.type is string && data.type == 'event'
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.participantIds is list && data.participantIds.size() >= 1
        && data.isActive is bool
        && (!('eventId' in data) || data.eventId is string);
    }
    
    function validateMessageData(data) {
      return data.keys().hasAll(['chatId', 'authorId', 'authorName', 'content', 'type'])
        && data.chatId is string
        && data.authorId is string
        && data.authorName is string && data.authorName.size() > 0 && data.authorName.size() <= 100
        && data.content is string && data.content.size() > 0 && data.content.size() <= 1000
        && data.type is string && data.type in ['text', 'system', 'image'];
    }
    
    function validateNotificationData(data) {
      return data.keys().hasAll(['userId', 'type', 'title', 'body', 'isRead'])
        && data.userId is string
        && data.type is string && data.type in ['event_invite', 'team_invite', 'event_update', 'event_cancelled', 'team_message', 'chat_message', 'general']
        && data.title is string && data.title.size() > 0 && data.title.size() <= 100
        && data.body is string && data.body.size() > 0 && data.body.size() <= 500
        && data.isRead is bool;
    }
    
    function validateSportProfileData(data) {
      return data.keys().hasAll(['userId', 'favoriteActivities', 'skillLevels', 'availability'])
        && data.userId is string
        && data.favoriteActivities is list
        && data.skillLevels is map
        && data.availability is list;
    }

    function validateTeamData(data) {
      return data.keys().hasAll(['name', 'sport', 'maxMembers', 'isPrivate', 'members'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && (!('description' in data) || (data.description is string && data.description.size() <= 500))
        && data.sport is string && data.sport in ['football', 'basketball', 'tennis', 'volleyball', 'badminton', 'handball', 'ping-pong', 'running', 'cycling', 'swimming', 'other']
        && data.maxMembers is number && data.maxMembers >= 2 && data.maxMembers <= 50
        && data.isPrivate is bool
        && data.members is list;
    }


    function validateTeamInviteCodeData(data) {
      return data.keys().hasAll(['teamId', 'code', 'expiresAt', 'isActive'])
        && data.teamId is string
        && data.code is string && data.code.size() == 6
        && data.expiresAt is timestamp
        && data.isActive is bool;
    }
  }
}