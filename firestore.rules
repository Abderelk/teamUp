rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Règles pour les utilisateurs - chaque utilisateur ne peut accéder qu'à ses propres données
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Règles pour les équipes - seuls les membres peuvent y accéder
    match /teams/{teamId} {
      allow read, write: if request.auth != null && 
        request.auth.uid in resource.data.members;
      allow create: if request.auth != null;
    }
    
    // Règles pour les événements - seuls les participants peuvent y accéder
    match /events/{eventId} {
      allow read, write: if request.auth != null && 
        (request.auth.uid == resource.data.createdBy || 
         request.auth.uid in resource.data.participants);
      allow create: if request.auth != null;
    }
    
    // Règles pour les messages d'équipes - seuls les membres de l'équipe peuvent y accéder
    match /teams/{teamId}/messages/{messageId} {
      allow read, write: if request.auth != null && 
        request.auth.uid in get(/databases/$(database)/documents/teams/$(teamId)).data.members;
    }
    
    // Règles pour les messages d'événements - seuls les participants peuvent y accéder
    match /events/{eventId}/messages/{messageId} {
      allow read, write: if request.auth != null && 
        (request.auth.uid == get(/databases/$(database)/documents/events/$(eventId)).data.createdBy || 
         request.auth.uid in get(/databases/$(database)/documents/events/$(eventId)).data.participants);
    }
    
    // Interdire l'accès à tout autre document
    match /{document=**} {
      allow read, write: if false;
    }
  }
}