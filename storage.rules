rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Images de profil utilisateurs
    match /profile-images/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Images d'événements
    match /event-images/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    // Images d'équipes
    match /team-images/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    // Images publiques - lectures pour tous les utilisateurs connectés
    match /public/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    // Règle temporaire pour debug - permettre tous les accès aux utilisateurs connectés
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
